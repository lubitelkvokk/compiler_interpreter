int n = 11;
int prev = 0;
int curr = 1;

if (n <= 0) print(0);
else
{
    if (n == 1) print(1);
    else
    {
        int next = 0;
        int ind = 2;
        while (ind <= n)
        {
            next = prev + curr;
            prev = curr;
            curr = next;
            ind = ind + 1;
        }
        print(curr);
    }
}
